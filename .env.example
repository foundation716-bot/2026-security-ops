# 복사해서 .env로 만든 뒤 값을 채운다 (값을 채우기 전에 먼저 복사한다: copy .env.example .env)
# .env는 커밋하지 않는다. 이 파일(.env.example)에는 실제 값을 넣지 않는다.
OPENAI_API_KEY=

# 보안 이벤트를 저장할 DB — M2 Day 11의 DB 컨테이너 주소 (Day 11 키트에서 docker compose up -d db)
# <비밀번호> 자리에 Day 11 .env의 POSTGRES_PASSWORD와 같은 값을 넣는다
DATABASE_URL=postgresql://postgres:<비밀번호>@localhost:5433/postgres

# 추적 끄기 — 2과목 Day 17에서 켰다면 여기서 끈다
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
